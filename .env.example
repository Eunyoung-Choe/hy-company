# 이 파일을 .env.local로 복사해 Supabase Project URL과 Publishable key를 입력합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 감사 로그 화면(/audit)용 서버 전용 키. NEXT_PUBLIC_ 을 붙이지 마세요. (브라우저로 노출 금지)
SUPABASE_SECRET_KEY=
AUDIT_BUCKET=pii-audit

# 원격 화면(/viewer)이 접속할 마스킹 에이전트 주소
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:8765
