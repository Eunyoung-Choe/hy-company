# 이 파일을 agent/.env 로 복사해 사용합니다. (.env 는 Git에 올라가지 않음)

# 캡처 대상: 모니터 번호(1=주 모니터) 또는 영역 left,top,width,height
# 모니터가 하나라면 데모 자료 창을 왼쪽 절반에 두고 그 영역만 캡처하세요.
# (뷰어 창까지 캡처하면 화면 속 화면이 무한 반복됩니다)
CAPTURE_MONITOR=1
CAPTURE_REGION=
CAPTURE_FPS=60
# 캡처 방식: auto(dxcam 우선, 실패 시 mss) | dxcam | mss
CAPTURE_BACKEND=auto

# OCR 엔진: auto = Windows 내장 OCR 우선(빠름), 없으면 EasyOCR / windows / easyocr
OCR_ENGINE=auto
# Windows OCR 입력 비율 (1.0 권장. 줄이면 작은 글씨를 놓침)
WINOCR_SCALE=1.0
# 아래 OCR_GPU / OCR_SCALE / OCR_THREADS 는 EasyOCR 전용
# OCR: auto = CUDA GPU가 있으면 사용, false = 항상 CPU
OCR_GPU=auto
OCR_LANGS=ko,en
# OCR 입력 축소 비율 (고DPI 화면은 0.5 권장, 작은 글씨가 놓치면 1.0)
OCR_SCALE=0.5
# CPU OCR 스레드 수 (비우면 코어 수의 절반)
OCR_THREADS=


# 마스킹 송출 (로컬 전용)
STREAM_HOST=127.0.0.1
STREAM_PORT=8765
# 송출 해상도 비율 (마스킹 후 축소, 고DPI 화면은 0.5면 충분)
STREAM_SCALE=0.5
# 원격 on/off 버튼을 누를 수 있는 웹 주소 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 감사 로그 (비우면 업로드 안 함). Secret key 는 서버/에이전트 전용, 브라우저에 절대 넣지 마세요.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AUDIT_BUCKET=pii-audit
AUDIT_INTERVAL_SEC=10
SESSION_ID=

# 녹화 (마스킹된 화면만 MP4로 저장). 비우면 agent/recordings
RECORD_DIR=
RECORD_FPS=15
