# 로컬 실행용. 이 파일을 .env로 복사해 값을 입력하세요. .env는 Git에 올라가지 않습니다.
# Colab에서는 이 파일 대신 왼쪽 🔑 Secrets에 같은 이름으로 등록합니다.
# 선택: CAPTION_BACKEND=openai일 때만 필요
# OPENAI_API_KEY=
NGROK_AUTHTOKEN=
# 선택: ngrok 무료 고정 도메인 (예: something.ngrok-free.dev)
NGROK_DOMAIN=
# 선택
# ALLOWED_ORIGINS=https://hy-company-ten.vercel.app,http://localhost:3000
# DINO_SIM_THRESHOLD=0.85
# MAX_KEYFRAMES=24
